{
  "info": {
    "name": "ToggleMaster - Fase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Criar flag",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/flags",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "flags"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"{{flagName}}\", \"is_enabled\": true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar flags",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/flags",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "flags"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"contém a flag\", () => pm.expect(pm.response.json().map(f => f.name)).to.include(pm.collectionVariables.get(\"flagName\") || pm.environment.get(\"flagName\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Consultar flag",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/flags/{{flagName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "flags",
            "{{flagName}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"habilitada\", () => pm.expect(pm.response.json().is_enabled).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Desativar flag",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/flags/{{flagName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "flags",
            "{{flagName}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"is_enabled\": false}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Consultar após update",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/flags/{{flagName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "flags",
            "{{flagName}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"desabilitada\", () => pm.expect(pm.response.json().is_enabled).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Remover flag",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/flags/{{flagName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "flags",
            "{{flagName}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Consultar removida (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/flags/{{flagName}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "flags",
            "{{flagName}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}