<mxfile host="app.diagrams.net"><diagram name="ToggleMaster - Fase 1" id="tm1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1100" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style='font-size:20px'&gt;ToggleMaster — Arquitetura AWS (Fase 1)&lt;/b&gt;&lt;br&gt;Monolito Flask em EC2 + Amazon RDS PostgreSQL · VPC com sub-redes pública e privadas" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="900" height="50" as="geometry" /></mxCell><mxCell id="cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="1290" height="960" as="geometry" /></mxCell><mxCell id="region" value="Region us-east-2 (Ohio)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="1240" height="900" as="geometry" /></mxCell><mxCell id="vpc" value="VPC tm-vpc · 10.0.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="980" height="840" as="geometry" /></mxCell><mxCell id="aza" value="Availability Zone us-east-2a" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="430" height="600" as="geometry" /></mxCell><mxCell id="azb" value="Availability Zone us-east-2b" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="200" width="430" height="600" as="geometry" /></mxCell><mxCell id="pub" value="Sub-rede pública tm-subnet-public1-us-east-2a · 10.0.1.0/24" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="390" height="270" as="geometry" /></mxCell><mxCell id="priva" value="Sub-rede privada tm-subnet-private1-us-east-2a · 10.0.11.0/24" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="420" y="540" width="390" height="240" as="geometry" /></mxCell><mxCell id="privb" value="Sub-rede privada tm-subnet-private2-us-east-2b · 10.0.12.0/24" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="880" y="540" width="390" height="240" as="geometry" /></mxCell><mxCell id="dbsg" value="DB subnet group tm-db-subnets (exige 2 AZs)" style="fillColor=none;strokeColor=#7D8998;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=right;spacingRight=10;fontStyle=2;fontColor=#5A6C86;html=1;whiteSpace=wrap;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="410" y="530" width="870" height="262" as="geometry" /></mxCell><mxCell id="sgec2" value="tm-ec2-sg" style="fillColor=none;strokeColor=#DD3522;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontColor=#DD3522;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="285" width="330" height="120" as="geometry" /></mxCell><mxCell id="sgrds" value="tm-rds-sg" style="fillColor=none;strokeColor=#DD3522;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontColor=#DD3522;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="580" width="330" height="120" as="geometry" /></mxCell><mxCell id="users" value="&lt;b&gt;Usuários&lt;/b&gt;&lt;br&gt;(Internet)" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.users;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="78" height="78" as="geometry" /></mxCell><mxCell id="admin" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;(casa · IP /32)" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.client;fillColor=#232F3E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="75" y="560" width="70" height="68" as="geometry" /></mxCell><mxCell id="igw" value="&lt;b&gt;Internet&lt;br&gt;Gateway&lt;/b&gt;" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.internet_gateway;fillColor=#8C4FFF;strokeColor=none;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="310" y="360" width="60" height="60" as="geometry" /></mxCell><mxCell id="ec2" value="&lt;b&gt;EC2 tm-app&lt;/b&gt; · t3.micro&lt;br&gt;Amazon Linux 2023 · role tm-ec2-role&lt;br&gt;nginx :80 → gunicorn 127.0.0.1:5000" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;fillColor=#ED7100;strokeColor=#FFFFFF;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;labelWidth=230;" vertex="1" parent="1"><mxGeometry x="490" y="315" width="66" height="66" as="geometry" /></mxCell><mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL 16.15&lt;/b&gt;&lt;br&gt;tm-db · db.t3.micro · Single-AZ&lt;br&gt;Public access: &lt;b&gt;No&lt;/b&gt; · criptografado" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#C925D1;strokeColor=#FFFFFF;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;labelWidth=230;" vertex="1" parent="1"><mxGeometry x="490" y="610" width="66" height="66" as="geometry" /></mxCell><mxCell id="rtpub" value="&lt;b&gt;Route table pública&lt;/b&gt;&lt;br&gt;10.0.0.0/16 → local&lt;br&gt;0.0.0.0/0 → IGW" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.route_table;fillColor=#8C4FFF;strokeColor=none;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;labelWidth=230;" vertex="1" parent="1"><mxGeometry x="470" y="830" width="60" height="52" as="geometry" /></mxCell><mxCell id="rtpriv" value="&lt;b&gt;Route table privada&lt;/b&gt;&lt;br&gt;10.0.0.0/16 → local&lt;br&gt;(sem NAT · sem saída)" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.route_table;fillColor=#8C4FFF;strokeColor=none;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=10;labelWidth=230;" vertex="1" parent="1"><mxGeometry x="900" y="830" width="60" height="52" as="geometry" /></mxCell><mxCell id="cred" value="🔑 Credenciais: Secrets Manager → &lt;b&gt;/run/togglemaster/env&lt;/b&gt; (root, 600, em memória) → env vars do processo (systemd)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="425" width="200" height="70" as="geometry" /></mxCell><mxCell id="privbnote" value="Sem recursos na Fase 1.&lt;br&gt;Existe porque o RDS exige subnet group em 2 AZs (habilita Multi-AZ no futuro)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fontColor=#5A6C86;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="920" y="620" width="310" height="60" as="geometry" /></mxCell><mxCell id="noint" value="&lt;b&gt;✗ Internet → RDS:&lt;/b&gt; sem IP público e sem rota de entrada" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fontColor=#DD3522;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="712" width="340" height="20" as="geometry" /></mxCell><mxCell id="pubb" value="Sub-rede pública tm-subnet-public2-us-east-2b · 10.0.2.0/24" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="880" y="240" width="390" height="270" as="geometry" /></mxCell><mxCell id="azbtop" value="Sem recursos na Fase 1.&lt;br&gt;Reservada para o Application Load Balancer (evolução: ALB exige 2 AZs)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fontColor=#5A6C86;fontStyle=2;align=center;" vertex="1" parent="1"><mxGeometry x="920" y="400" width="310" height="50" as="geometry" /></mxCell><mxCell id="sm" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;br&gt;secret togglemaster/db" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1390" y="300" width="66" height="66" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b style='font-size:13px'&gt;Regras de Security Group&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#DD3522'&gt;tm-ec2-sg — entrada&lt;/b&gt;&lt;br&gt;TCP 80 (HTTP) · 0.0.0.0/0&lt;br&gt;TCP 443 (HTTPS) · 0.0.0.0/0&lt;br&gt;TCP 22 (SSH) · &amp;lt;ip-casa&amp;gt;/32&lt;br&gt;&lt;i&gt;TCP 5000 fechada (nginx atende na 80)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b style='color:#DD3522'&gt;tm-ec2-sg — saída&lt;/b&gt;&lt;br&gt;TCP 80/443 · 0.0.0.0/0 (pacotes, git, APIs AWS)&lt;br&gt;TCP 5432 · tm-rds-sg&lt;br&gt;&lt;br&gt;&lt;b style='color:#DD3522'&gt;tm-rds-sg — entrada&lt;/b&gt;&lt;br&gt;TCP 5432 · origem &lt;b&gt;tm-ec2-sg&lt;/b&gt; (sem CIDR)&lt;br&gt;&lt;br&gt;&lt;b style='color:#DD3522'&gt;tm-rds-sg — saída&lt;/b&gt;&lt;br&gt;nenhuma (SG é stateful)&lt;br&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Acesso ao banco de casa&lt;/b&gt;&lt;br&gt;Túnel SSH pela EC2:&lt;br&gt;&lt;font face='monospace'&gt;ssh -L 5432:&amp;lt;rds&amp;gt;:5432 ec2-user@&amp;lt;ec2&amp;gt;&lt;/font&gt;&lt;br&gt;RDS continua aceitando só tm-ec2-sg.&lt;br&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Custo estimado&lt;/b&gt; ≈ US$ 27/mês&lt;br&gt;(us-east-2, on-demand, sem NAT Gateway)" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DD3522;strokeWidth=1;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1550" y="120" width="290" height="590" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Fluxos&lt;/b&gt;&lt;br&gt;&lt;font color='#232F3E'&gt;━━&lt;/font&gt; ① Requisição HTTP/HTTPS do usuário&lt;br&gt;&lt;font color='#ED7100'&gt;┅┅&lt;/font&gt; ② SSH / túnel do administrador&lt;br&gt;&lt;font color='#C925D1'&gt;━━&lt;/font&gt; ③ EC2 → RDS PostgreSQL :5432&lt;br&gt;&lt;font color='#DD344C'&gt;┅┅&lt;/font&gt; ④ EC2 → Secrets Manager (HTTPS, IAM role)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#F8F9FA;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="730" width="290" height="115" as="geometry" /></mxCell><mxCell id="e1" value="① HTTP :80 / HTTPS :443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;strokeColor=#232F3E;fontColor=#232F3E;" edge="1" parent="1" source="users" target="igw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="①② 80 · 443 · 22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;strokeColor=#232F3E;fontColor=#232F3E;" edge="1" parent="1" source="igw" target="ec2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="390" /><mxPoint x="440" y="348" /></Array></mxGeometry></mxCell><mxCell id="e3" value="② SSH :22 · túnel :5432&lt;br&gt;(somente &amp;lt;ip-casa&amp;gt;/32)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;strokeColor=#ED7100;fontColor=#ED7100;dashed=1;" edge="1" parent="1" source="admin" target="igw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="594" /><mxPoint x="250" y="400" /></Array></mxGeometry></mxCell><mxCell id="e5" value="④ GetSecretValue (role tm-ec2-role)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;strokeColor=#DD344C;fontColor=#DD344C;dashed=1;" edge="1" parent="1" source="ec2" target="sm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="523" y="275" /><mxPoint x="1340" y="275" /><mxPoint x="1340" y="333" /></Array></mxGeometry></mxCell><mxCell id="e4" value="③ PostgreSQL :5432&lt;br&gt;origem = tm-ec2-sg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;strokeColor=#C925D1;fontColor=#C925D1;" edge="1" parent="1" source="ec2" target="rds"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>